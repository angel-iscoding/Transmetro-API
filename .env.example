# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=transmetro_db
POSTGRES_USER=transmetro_user
POSTGRES_PASSWORD=transmetro_password

# MongoDB Configuration
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DB=transmetro_mongo
MONGODB_USER=transmetro_user
MONGODB_PASSWORD=transmetro_password

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Application Configuration
NODE_ENV=development
PORT=3000

# Database URLs (if needed)
POSTGRES_URL=postgresql://transmetro_user:transmetro_password@postgres:5432/transmetro_db
MONGODB_URL=mongodb://transmetro_user:transmetro_password@mongodb:27017/transmetro_mongo
